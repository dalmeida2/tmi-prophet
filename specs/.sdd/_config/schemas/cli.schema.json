{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD CLI contract (specs/contracts/cli.json)",
  "description": "Every command, argument, flag, exit code and output format of a CLI (or a game's headless simulation entry point). Fixtures cover each declared exit code as cmd:<name>:<code>.",
  "type": "object",
  "required": ["binary", "commands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "binary": { "type": "string", "description": "Program name. The oracle locates the build's executable through the target env (e.g. ${APP_CLI}); see oracle-standard.md." },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "usage", "exitCodes", "stdout"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Subcommand name; use \"main\" for a single-command program." },
          "usage": { "type": "string", "description": "Exact usage line." },
          "description": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "enum": ["string", "integer", "number", "boolean", "path", "enum"] },
                "required": { "type": "boolean" },
                "values": { "type": "array", "items": { "type": "string" } },
                "description": { "type": "string" }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" },
                "short": { "type": "string", "pattern": "^-[a-zA-Z]$" },
                "type": { "enum": ["string", "integer", "number", "boolean", "path", "enum"] },
                "default": {},
                "values": { "type": "array", "items": { "type": "string" } },
                "description": { "type": "string" }
              }
            }
          },
          "exitCodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "meaning"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "integer", "minimum": 0, "maximum": 255 },
                "meaning": { "type": "string" },
                "error": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "errors.json code reported with this exit code." }
              }
            }
          },
          "stdout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "description": "Exact text format (template) of human-readable output." },
              "json": { "description": "JSON Schema of the --json document." }
            }
          },
          "stdin": { "type": "string", "description": "What the command reads from stdin, if anything." }
        }
      }
    }
  }
}
