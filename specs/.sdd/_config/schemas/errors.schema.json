{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD error taxonomy (specs/contracts/errors.json)",
  "description": "Canonical error codes. HTTP responses render these as RFC 9457 problem details (see systems-standards.md §4); CLI tools map them to exit codes.",
  "type": "object",
  "required": ["errors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "typeBaseUri": {
      "description": "Problem `type` = typeBaseUri + code. Required when any error has an HTTP status.",
      "type": "string",
      "pattern": "^https?://.+/$"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "title", "retryable"],
        "additionalProperties": false,
        "anyOf": [{ "required": ["status"] }, { "required": ["exitCode"] }],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "description": "Fixed per code; never request-specific." },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 },
          "retryable": { "type": "boolean" },
          "description": { "type": "string", "description": "When this error is raised (trigger conditions)." }
        }
      }
    }
  }
}
