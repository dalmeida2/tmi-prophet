    {
      "id": "NOTE-032",
      "title": "Out-of-range or non-integer limit is 422",
      "phase": 3,
      "derivedFrom": [
        "profile PAGE-1",
        "profile ERR-3"
      ],
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/notes",
            "query": {
              "limit": 0
            }
          },
          "expect": {
            "status": 422,
            "headers": {
              "content-type": "application/problem+json",
              "etag": {
                "$absent": true
              }
            },
            "body": {
              "type": "https://errors.notes.example/VALIDATION_ERROR",
              "title": "Validation failed",
              "status": 422,
              "detail": {
                "$type": "string"
              },
              "instance": "/notes",
              "code": "VALIDATION_ERROR",
              "retryable": false,
              "errors": [
                {
                  "in": "query",
                  "pointer": "limit",
                  "issue": "minimum"
                }
              ]
            }
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/notes",
            "query": {
