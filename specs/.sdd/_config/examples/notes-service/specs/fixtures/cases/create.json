{
  "$schema": "../../../../../schemas/oracle-cases.schema.json",
  "suite": "create",
  "description": "Phase 2: createNote and getNote.",
  "cases": [
    {
      "id": "NOTE-010",
      "title": "Create returns 201 with Location, ETag and the full note; read returns the same note",
      "phase": 2,
      "covers": [
        "inv:V1"
      ],
      "derivedFrom": [
        "SPEC §5.1",
        "openapi createNote 201",
        "openapi getNote 200",
        "profile HTTP-1",
        "profile OCC-1",
        "profile OCC-2",
        "profile HTTP-10"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Groceries",
              "body": "milk, eggs"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": {
                "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": {
                "$type": "uuidv7"
              },
              "title": "Groceries",
              "body": "milk, eggs",
              "status": "draft",
              "version": 1,
              "created_at": {
                "$type": "datetime"
              },
              "updated_at": {
                "$type": "datetime"
              }
            }
          },
          "id": "create",
          "capture": {
            "noteId": "body.id",
            "created": "body.created_at"
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/notes/{{noteId}}"
          },
          "expect": {
            "status": 200,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": "{{noteId}}",
              "title": "Groceries",
              "body": "milk, eggs",
              "status": "draft",
              "version": 1,
              "created_at": "{{created}}",
              "updated_at": "{{created}}"
            }
          }
        }
      ]
    },
