    {
      "id": "NOTE-022",
      "title": "Concurrent requests with one key: one creates, the other is 409 in flight",
      "phase": 2,
      "derivedFrom": [
        "profile IDEM-5",
        "profile ENV-5"
      ],
      "steps": [
        {
          "parallel": [
            {
              "method": "POST",
              "path": "/notes",
              "headers": {
                "Idempotency-Key": "{{$uuid:k1}}"
              },
              "body": {
                "title": "Race"
              }
            },
            {
              "method": "POST",
              "path": "/notes",
              "headers": {
                "Idempotency-Key": "{{$uuid:k1}}"
              },
              "body": {
                "title": "Race"
              }
            }
          ],
          "expect": {
            "responses": [
              {
                "status": 201,
                "headers": {
                  "content-type": "application/json",
                  "etag": "\"v1\"",
                  "location": {
                    "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "idempotent-replay": {
                    "$absent": true
                  }
                },
                "body": {
                  "id": {
                    "$type": "uuidv7"
                  },
                  "title": "Race",
                  "body": "",
                  "status": "draft",
                  "version": 1,
                  "created_at": {
                    "$type": "datetime"
                  },
                  "updated_at": {
                    "$type": "datetime"
                  }
                }
              },
              {
                "status": 409,
                "headers": {
                  "content-type": "application/problem+json",
                  "etag": {
                    "$absent": true
                  },
                  "retry-after": "1"
                },
                "body": {
                  "type": "https://errors.notes.example/IDEMPOTENCY_IN_FLIGHT",
                  "title": "Request with this idempotency key is in progress",
                  "status": 409,
                  "detail": {
                    "$type": "string"
                  },
                  "instance": "/notes",
                  "code": "IDEMPOTENCY_IN_FLIGHT",
                  "retryable": true,
                  "errors": []
                }
              }
            ]
          }
        }
      ]
    },
