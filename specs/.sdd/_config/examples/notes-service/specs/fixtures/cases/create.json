    {
      "id": "NOTE-020",
      "title": "Replay with the same key returns the stored response and creates nothing",
      "phase": 2,
      "covers": [
        "inv:V4"
      ],
      "derivedFrom": [
        "profile IDEM-6",
        "SPEC V4"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Once"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": {
                "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": {
                "$type": "uuidv7"
              },
              "title": "Once",
              "body": "",
              "status": "draft",
              "version": 1,
              "created_at": {
                "$type": "datetime"
              },
              "updated_at": {
                "$type": "datetime"
              }
            }
          },
          "capture": {
            "noteId": "body.id",
            "created": "body.created_at"
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Once"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": "/notes/{{noteId}}",
              "idempotent-replay": "true"
            },
            "body": {
              "id": "{{noteId}}",
              "title": "Once",
              "body": "",
              "status": "draft",
              "version": 1,
              "created_at": "{{created}}",
              "updated_at": "{{created}}"
            }
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/notes"
          },
          "expect": {
            "status": 200,
            "headers": {
              "content-type": "application/json",
              "etag": {
                "$absent": true
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "data": [
                {
                  "id": "{{noteId}}",
                  "title": "Once",
                  "body": "",
                  "status": "draft",
                  "version": 1,
                  "created_at": "{{created}}",
                  "updated_at": "{{created}}"
                }
              ],
              "pagination": {
                "next_cursor": null,
                "has_more": false
              }
            }
          }
        }
      ]
