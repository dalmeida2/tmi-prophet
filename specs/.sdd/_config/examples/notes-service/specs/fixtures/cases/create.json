    {
      "id": "NOTE-013",
      "title": "Two body violations are reported together, sorted by pointer",
      "phase": 2,
      "derivedFrom": [
        "profile ERR-3",
        "profile SER-8",
        "openapi NoteCreate"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "",
              "extra": 1
            }
          },
          "expect": {
            "status": 422,
            "headers": {
              "content-type": "application/problem+json",
              "etag": {
                "$absent": true
              }
            },
            "body": {
              "type": "https://errors.notes.example/VALIDATION_ERROR",
              "title": "Validation failed",
              "status": 422,
              "detail": {
                "$type": "string"
              },
              "instance": "/notes",
              "code": "VALIDATION_ERROR",
              "retryable": false,
              "errors": [
                {
                  "in": "body",
                  "pointer": "/extra",
                  "issue": "additionalProperties"
                },
                {
                  "in": "body",
                  "pointer": "/title",
                  "issue": "minLength"
                }
              ]
            }
          }
        }
      ]
    },
