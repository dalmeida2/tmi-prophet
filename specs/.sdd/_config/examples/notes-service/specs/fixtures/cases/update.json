{
  "$schema": "../../../../../schemas/oracle-cases.schema.json",
  "suite": "update",
  "description": "Phase 4: updateNote and deleteNote.",
  "cases": [
    {
      "id": "NOTE-050",
      "title": "Patch changes only the given field and bumps version and ETag",
      "phase": 4,
      "covers": [
        "inv:V1"
      ],
      "derivedFrom": [
        "profile HTTP-2",
        "profile OCC-1",
        "SPEC §5.2"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Groceries"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": {
                "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": {
                "$type": "uuidv7"
              },
              "title": "Groceries",
              "body": "",
              "status": "draft",
              "version": 1,
              "created_at": {
                "$type": "datetime"
              },
              "updated_at": {
                "$type": "datetime"
              }
            }
          },
          "capture": {
            "noteId": "body.id",
            "created": "body.created_at"
          }
        },
        {
          "http": {
            "method": "PATCH",
            "path": "/notes/{{noteId}}",
            "headers": {
              "If-Match": "\"v1\""
            },
            "body": {
              "title": "New"
            }
          },
          "expect": {
            "status": 200,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v2\"",
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": "{{noteId}}",
              "title": "New",
              "body": "",
              "status": "draft",
              "version": 2,
              "created_at": "{{created}}",
              "updated_at": {
                "$type": "datetime"
              }
            }
          }
        }
      ]
    },
