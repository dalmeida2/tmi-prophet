    {
      "id": "NOTE-058",
      "title": "Concurrent patches with the same If-Match: one wins, one is 412",
      "phase": 4,
      "derivedFrom": [
        "profile OCC-4",
        "profile ENV-5"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Groceries"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": {
                "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": {
                "$type": "uuidv7"
              },
              "title": "Groceries",
              "body": "",
              "status": "draft",
              "version": 1,
              "created_at": {
                "$type": "datetime"
              },
              "updated_at": {
                "$type": "datetime"
              }
            }
          },
          "capture": {
            "noteId": "body.id",
            "created": "body.created_at"
          }
        },
        {
          "parallel": [
            {
              "method": "PATCH",
              "path": "/notes/{{noteId}}",
              "headers": {
                "If-Match": "\"v1\""
              },
              "body": {
                "title": "One"
              }
            },
            {
              "method": "PATCH",
              "path": "/notes/{{noteId}}",
              "headers": {
                "If-Match": "\"v1\""
              },
              "body": {
                "title": "One"
              }
            }
          ],
          "expect": {
            "responses": [
              {
                "status": 200,
                "headers": {
                  "content-type": "application/json",
                  "etag": "\"v2\"",
                  "idempotent-replay": {
                    "$absent": true
                  }
                },
                "body": {
                  "id": "{{noteId}}",
                  "title": "One",
                  "body": "",
                  "status": "draft",
                  "version": 2,
                  "created_at": "{{created}}",
                  "updated_at": {
                    "$type": "datetime"
                  }
                }
              },
              {
                "status": 412,
                "headers": {
                  "content-type": "application/problem+json",
                  "etag": {
                    "$absent": true
                  }
                },
                "body": {
                  "type": "https://errors.notes.example/PRECONDITION_FAILED",
                  "title": "Precondition failed",
                  "status": 412,
                  "detail": {
                    "$type": "string"
                  },
                  "instance": "/notes/{{noteId}}",
                  "code": "PRECONDITION_FAILED",
                  "retryable": false,
                  "errors": []
                }
              }
            ]
          }
        }
      ]
    },
