{
  "$schema": "../../../../../schemas/oracle-cases.schema.json",
  "suite": "publish",
  "description": "Phase 5: publishNote, and rules that need published notes.",
  "cases": [
    {
      "id": "NOTE-060",
      "title": "Publishing a draft moves it to published and bumps version",
      "phase": 5,
      "covers": [
        "transition:note.publish",
        "inv:V1"
      ],
      "derivedFrom": [
        "statecharts note.publish",
        "profile OCC-1"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/notes",
            "headers": {
              "Idempotency-Key": "{{$uuid:k1}}"
            },
            "body": {
              "title": "Groceries"
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v1\"",
              "location": {
                "$regex": "^/notes/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": {
                "$type": "uuidv7"
              },
              "title": "Groceries",
              "body": "",
              "status": "draft",
              "version": 1,
              "created_at": {
                "$type": "datetime"
              },
              "updated_at": {
                "$type": "datetime"
              }
            }
          },
          "capture": {
            "noteId": "body.id",
            "created": "body.created_at"
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/notes/{{noteId}}/publish",
            "headers": {
              "Idempotency-Key": "{{$uuid:p1}}"
            }
          },
          "expect": {
            "status": 200,
            "headers": {
              "content-type": "application/json",
              "etag": "\"v2\"",
              "idempotent-replay": {
                "$absent": true
              }
            },
            "body": {
              "id": "{{noteId}}",
              "title": "Groceries",
              "body": "",
              "status": "published",
              "version": 2,
              "created_at": "{{created}}",
              "updated_at": {
                "$type": "datetime"
              }
            }
          }
        }
      ]
    },
